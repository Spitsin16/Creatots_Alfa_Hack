    {
      "name": "01 — Клиент p3b: предложение → выдача",
      "description": "Главный сценарий кофейни. Запускайте после сброса Docker volume.",
      "item": [
        {
          "name": "01 — Войти как клиент p3b",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"p3b\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"clientToken\", body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Получить профиль и бизнес",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Есть доступный бизнес\", function () { pm.expect(body.businesses.length).to.be.above(0); });",
                  "pm.collectionVariables.set(\"businessId\", body.businesses[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Дать согласия БКИ и ФНС",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/businesses/{{businessId}}/consents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kinds\": [\n    \"BKI\",\n    \"FNS\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — Получить прогноз кассового разрыва",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/businesses/{{businessId}}/forecast",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — Рассчитать предложение на 340 000 ₽",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/businesses/{{businessId}}/pre-offers",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"cash_gap\",\n  \"amount_kopecks\": 34000000,\n  \"term_months\": 12,\n  \"frequency\": \"always\",\n  \"urgency\": \"days\",\n  \"priority\": \"small_payment\",\n  \"repayment\": \"equal\",\n  \"assets\": [\n    \"none\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"preOfferId\", body.id);",
                  "pm.test(\"Лимит до выписки — 270 000 ₽\", function () { pm.expect(body.limit_kopecks).to.eql(27000000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — Получить объяснение предложения",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/pre-offers/{{preOfferId}}/explanation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 — Загрузить выписку 1С и пересчитать лимит",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pre-offers/{{preOfferId}}/statement",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "file",
              "file": {
                "src": "data/statements/p3b_other_bank_1c.txt"
              }
            },
            "description": "В Postman при первом запуске выберите локальный файл data/statements/p3b_other_bank_1c.txt. Тело передаётся как application/octet-stream, не multipart."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"preOfferId\", body.pre_offer.id);",
                  "pm.test(\"Лимит после выписки — 360 000 ₽\", function () { pm.expect(body.pre_offer.limit_kopecks).to.eql(36000000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 — Создать черновик заявки",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/applications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pre_offer_id\": \"{{preOfferId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"applicationId\", body.id);",
                  "pm.test(\"Создан черновик\", function () { pm.expect(body.status).to.eql(\"DRAFT\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "09 — Отправить заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{applicationId}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/submit",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10 — Дождаться автоматического решения",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Worker обрабатывает заявку асинхронно. В Collection Runner запрос повторяется до финального решения."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.status === \"APPROVED\") {",
                  "  pm.test(\"Заявка одобрена\", function () { pm.expect(body.status).to.eql(\"APPROVED\"); });",
                  "} else if ([\"REJECTED\", \"COUNTER_OFFER\", \"MANUAL_REVIEW\"].includes(body.status)) {",
                  "  throw new Error(\"Вместо автоматического одобрения получен статус \" + body.status);",
                  "} else {",
                  "  pm.execution.setNextRequest(\"10 — Дождаться автоматического решения\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "11 — Написать сообщение специалисту",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/messages",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Когда деньги поступят на счёт?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 — Подписать договор демо-кодом",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "sign-{{applicationId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/sign",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "13 — Дождаться симулированной выдачи",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.status !== \"ISSUED\") { pm.execution.setNextRequest(\"13 — Дождаться симулированной выдачи\"); }",
                  "else { pm.test(\"Кредит выдан\", function () { pm.expect(body.status).to.eql(\"ISSUED\"); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "14 — Открыть кабинет выданного кредита",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/loan",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "15 — Получить уведомления",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
